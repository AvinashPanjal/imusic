# Database
# For local PostgreSQL or remote (Supabase, Neon, RDS, etc.):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/imusic?schema=public"

# Alternatively, for SQLite fallback during lightweight local testing without Postgres running:
# DATABASE_URL="file:./dev.db"

# Storage Provider for Private Ingestion (s3 | local)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/audio"

# S3 Configuration (if STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="imusic-vault"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Application Configuration
NEXT_PUBLIC_APP_NAME="iMusic"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Auth / Session Secret
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret"

# Optional External Catalogue API Keys (all fully optional; app gracefully handles unconfigured APIs)
JAMENDO_CLIENT_ID=""
LASTFM_API_KEY=""
DISCOGS_API_TOKEN=""
